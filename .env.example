# Copy this file to .env.local for local development.
# Never commit .env, .env.local, or real credentials.

# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# Optional direct MySQL URL for database commands. Runtime uses DATABASE_URL first.
# DIRECT_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# Railway MySQL variables are accepted when DATABASE_URL is not set.
# MYSQLHOST="mysql.railway.internal"
# MYSQLPORT="3306"
# MYSQLUSER="root"
# MYSQLPASSWORD=""
# MYSQLDATABASE="railway"
# MYSQL_DATABASE="railway"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-secret"
# NEXTAUTH_SECRET is supported as a legacy fallback for AUTH_SECRET.
# NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Production Railway URL. Use http://localhost:3000 only in .env.local.
NEXTAUTH_URL="https://ecorewards.up.railway.app"
# Allows demo sign-in locally when DATABASE_URL points to localhost and MySQL is unavailable.
# Never enable this in production.
# MOCK_AUTH="true"
# AUTH_TRUST_HOST="true"

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Gemini AI assistant and waste classification (optional)
# GEMINI_API_KEY=""
# GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
# GEMINI_VISION_MODEL="gemini-2.5-flash"

# Email verification and password reset (optional)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="EcoRewards <noreply@example.com>"

# Cloudinary image uploads (optional)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

Build Command: npm install && npm run build:railway
Start Command: npm run start
